# Copy to .env (git-ignored) and fill in. Referenced from config.yaml as ${NAME}.
# Never commit the real .env - this repository is public.

# --- Devices -------------------------------------------------------------
FLASH_HOST=192.0.2.10
FLASH_API_KEY=          # read-only API key created in the Bluefors control software
PLASSYS_HOST=192.0.2.11

# --- Notifications ---------------------------------------------------------
DISCORD_WEBHOOK_URL=    # https://discord.com/api/webhooks/<id>/<token>
TELEGRAM_BOT_TOKEN=     # from @BotFather, looks like 123456789:AA...
TELEGRAM_CHAT_ID=       # your chat id (see README: Telegram)
TELEGRAM_CRITICAL_CHAT_ID=
NTFY_TOPIC=             # long random string, acts as a password on ntfy.sh
SMTP_USER=
SMTP_PASSWORD=

# --- Dead man's switch -------------------------------------------------------
HEARTBEAT_URL=          # e.g. https://hc-ping.com/<uuid> from healthchecks.io
